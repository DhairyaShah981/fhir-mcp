# =============================================================================
# fhir-mcp configuration
# All variables are OPTIONAL. The server runs zero-config out of the box.
# Copy to .env and uncomment what you need.
# =============================================================================

# --- FHIR backend ------------------------------------------------------------
# One of: synthea (default, in-memory), hapi
# FHIR_MCP_BACKEND=synthea

# HAPI public test server URL (only used when backend=hapi)
# FHIR_MCP_HAPI_BASE_URL=https://hapi.fhir.org/baseR4

# --- De-identification -------------------------------------------------------
# Always-on PHI detection. Re-identification is opt-in.
# FHIR_MCP_ENABLE_REID=false
# FHIR_MCP_REID_KEY=                              # required if ENABLE_REID=true

# --- Audit / storage ---------------------------------------------------------
# Default = SQLite at ~/.fhir-mcp/audit.db
# FHIR_MCP_AUDIT_URL=sqlite+aiosqlite:////Users/you/.fhir-mcp/audit.db

# Supabase (cloud audit + vault). Falls back to SQLite if unset.
# REST credentials (currently informational; Postgres direct connection is what
# the audit + vault use).
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Postgres connection used by audit + vault when cloud mode is on. Either of:
#   postgres://...
#   postgresql://...
#   postgresql+asyncpg://...
# All three forms are normalized to asyncpg internally.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Separate vault store (advanced). Leave unset to reuse SUPABASE_DB_URL.
# FHIR_MCP_VAULT_URL=

# --- Observability -----------------------------------------------------------
# Langfuse — no-op when unset
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Eval harness ------------------------------------------------------------
# Required to run clinical-accuracy evals (judge LLM)
# ANTHROPIC_API_KEY=
# FHIR_MCP_EVAL_JUDGE_MODEL=claude-sonnet-4-6

# --- SMART on FHIR -----------------------------------------------------------
# Required when calling `fhir-mcp smart-login`. See README → "SMART on FHIR".
# FHIR_MCP_SMART_ISSUER=https://launch.smarthealthit.org/v/r4/fhir
# FHIR_MCP_SMART_CLIENT_ID=
# FHIR_MCP_SMART_REDIRECT_URI=http://localhost:8765/smart/callback
# FHIR_MCP_SMART_SCOPES=patient/*.read fhir-mcp/reid

# Backend-services flow only (asymmetric JWT bearer per SMART v2).
# FHIR_MCP_SMART_PRIVATE_KEY_PEM=
# FHIR_MCP_SMART_KEY_ID=

# --- CDS Hooks ---------------------------------------------------------------
# CDS Hooks discovery endpoint. Defaults to public sandbox.
# FHIR_MCP_CDS_HOOKS_URL=https://cds.logicahealth.org

# --- Terminology -------------------------------------------------------------
# FHIR_MCP_TERMINOLOGY_URL=https://tx.fhir.org/r4

# --- Logging -----------------------------------------------------------------
# FHIR_MCP_LOG_LEVEL=INFO
# FHIR_MCP_VERBOSE_AUDIT=false                    # log argument values, not just hashes
